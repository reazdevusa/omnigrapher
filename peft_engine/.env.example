# PEFT Engine service configuration
PEFT_HOST=0.0.0.0
PEFT_PORT=8002
PEFT_DEBUG=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base model to load in 4-bit
PEFT_BASE_MODEL=unsloth/Llama-3.2-3B-Instruct
PEFT_MAX_SEQ_LENGTH=2048

# LoRA defaults
PEFT_R=16
PEFT_ALPHA=16
PEFT_DROPOUT=0
PEFT_BIAS=none
PEFT_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
PEFT_USE_GRADIENT_CHECKPOINTING=unsloth

# Training defaults
PEFT_EPOCHS=3
PEFT_LEARNING_RATE=0.0002
PEFT_BATCH_SIZE=2
PEFT_GRADIENT_ACCUMULATION_STEPS=4
PEFT_OPTIM=adamw_8bit
PEFT_WARMUP_STEPS=5
PEFT_LOGGING_STEPS=1
PEFT_SAVE_STEPS=50
PEFT_SEED=42

# Paths
PEFT_ADAPTER_DIR=./adapters
PEFT_DATASET_DIR=./datasets
PEFT_OUTPUT_DIR=./outputs

# GGUF export
PEFT_GGUF_QUANTIZATION=q4_k_m
