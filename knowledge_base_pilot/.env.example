# Backend settings
# Use a strong random string for JWT signing in production
SECRET_KEY=change-me-in-production

# JWT token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest

# Managed LLM provider API keys (Phase 1)
# At least one is required; Gemini Flash is the free-tier default
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Optional: proxy/base URL for xAI/Grok
# XAI_BASE_URL=https://api.x.ai/v1
DEEPSEEK_API_KEY=
# Optional: proxy/base URL for DeepSeek
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Billing / cost controls
PROFIT_MARGIN=0.5

LLM_FALLBACK_MODEL=llama3:latest
EMBED_MODEL=nomic-embed-text:latest

# Hardware overrides are optional; omit them to auto-detect RAM and NVIDIA VRAM
# SYSTEM_RAM_GB=32
# GPU_VRAM_GB=6
# Context values are clamped to safe limits for detected hardware
# OLLAMA_NUM_CTX=4096
# OLLAMA_EMBED_NUM_CTX=2048
# EMBEDDING_BATCH_SIZE=8

# Document ingestion controls
INGESTION_WORKER_ENABLED=true
INGESTION_TIMEOUT_SECONDS=600
WORKER_POLL_SECONDS=2
OCR_MIN_TEXT_CHARS=40
MAX_UPLOAD_MB=250

# Set CHROMA_HOST to use the Chroma server; omit it for local persistent Chroma
# CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_SSL=false

# SQLite database path (default: kb.db inside knowledge_base_pilot)
DATABASE_URL=sqlite:///kb.db

# PostgreSQL with pgvector (uncomment to use instead of SQLite for production):
# PG_DATABASE_URL=postgresql://awap_user:awap_password@localhost:5433/knowledge_base
# PGVECTOR_DIMENSION=384

# Redis (for queues, caching, rate-limiting)
REDIS_URL=redis://localhost:6379

# Alembic migrations directory (optional, defaults to ./alembic)
# ALEMBIC_CONFIG=alembic.ini

# Object storage (Cloudflare R2, S3-compatible) — optional, falls back to local disk if not configured
# STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./knowledge_base
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ai-kb-uploads
